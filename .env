# Local development defaults — safe to commit for this demo app.
# Override in production; never commit real secrets.
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="ibd-dev-only-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional: enables live Claude-based policy extraction. Without it, the app
# runs the deterministic mock extraction provider.
# ANTHROPIC_API_KEY="sk-ant-..."
# EXTRACTION_MODEL="claude-sonnet-5"
